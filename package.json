{
  "name": "@bonniepdf/previewer",
  "version": "2026.10.28",
  "description": "Framework-agnostic PDF preview component for BonniePDF — renders the SVG pages from @bonniepdf/core as a paginated, zoomable viewer with thumbnails. Ships as a Shadow-DOM web component, fully isolated from host-page CSS.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "CodeFocus Limited",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "./src/element.ts"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --noEmit false --emitDeclarationOnly --outDir dist && node scripts/fix-dts-extensions.mjs dist && node scripts/emit-cjs-declarations.mjs dist",
    "check:consumer-types": "tsc -p scripts/consumer-types/tsconfig.json",
    "prepublishOnly": "pnpm run check:consumer-types",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run"
  },
  "keywords": [
    "pdf",
    "preview",
    "viewer",
    "svg",
    "web-component",
    "custom-element",
    "bonniepdf"
  ],
  "peerDependencies": {
    "@bonniepdf/core": ">=2026.7.2"
  },
  "peerDependenciesMeta": {
    "@bonniepdf/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bonniepdf/core": "workspace:*",
    "jsdom": "30.0.1",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
